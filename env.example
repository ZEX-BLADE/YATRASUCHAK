# Copy to .env for local overrides (this backend also works with zero
# config - it defaults to a local SQLite file).

# Leave unset to use local SQLite (data/yatrasuchak.db). On Render, this
# is injected automatically when you attach the yatrasuchak-db database
# from render.yaml.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Origin of your deployed frontend, added to the CORS allow-list.
# FRONTEND_ORIGIN=https://your-frontend.onrender.com
